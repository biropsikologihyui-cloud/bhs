    ];

    let currentUser = null;
    let timerInterval = null;
    let photoInterval = null;
    let timeLeft = 480; // 8 MENIT (480 Detik)
    let videoStream = null;
    let currentIndex = 0;
    let userAnswers = {}; // Format: { 41: ["a", "e"], 42: ["c", "f"] }
    let violationCount = 0;
    let isExamActive = false;

    const video = document.getElementById('webcam');
    const canvas = document.getElementById('canvas');

    function sendData(payload) {
      return fetch(APPS_SCRIPT_URL, {
        method: "POST",
        headers: { "Content-Type": "text/plain;charset=utf-8" },
        body: JSON.stringify(payload)
      }).then(res => res.json());
    }

    function setStep(stepNum) {
      for (let i = 1; i <= 4; i++) {
        const el = document.getElementById(`step${i}Indicator`);
        if (!el) continue;
        if (i < stepNum) {
          el.className = "flex items-center gap-2 text-emerald-400 font-bold";
          el.children[0].className = "w-6 h-6 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs";
          el.children[0].innerText = "✓";
        } else if (i === stepNum) {
          el.className = "flex items-center gap-2 text-blue-400 font-bold";
          el.children[0].className = "w-6 h-6 rounded-full bg-blue-600 text-white flex items-center justify-center text-xs";
          el.children[0].innerText = i;
        } else {
          el.className = "flex items-center gap-2 text-slate-500 font-medium";
          el.children[0].className = "w-6 h-6 rounded-full bg-slate-700 text-slate-400 flex items-center justify-center text-xs";
          el.children[0].innerText = i;
        }
      }
    }

    function processLogin() {
      const u = document.getElementById('inputUsername').value;
      const p = document.getElementById('inputPassword').value;
      const btn = document.getElementById('btnLogin');
      const errBox = document.getElementById('loginError');

      if (!u || !p) {
        errBox.innerText = "Username dan Password wajib diisi!";
        errBox.classList.remove('hidden');
        return;
      }

      btn.disabled = true;
      btn.innerText = "Meminta Akses Kamera...";
      errBox.classList.add('hidden');

      navigator.mediaDevices.getUserMedia({ video: true, audio: false })
      .then(function(stream) {
        videoStream = stream;
        video.srcObject = stream;

        btn.innerText = "Memverifikasi Akun...";

        sendData({ action: "checkLogin", username: u, password: p })
        .then(res => {
          if (res.success) {
            currentUser = res;
            if (!currentUser.username) currentUser.username = u;

            document.getElementById('dispNama').innerText = res.name || u;
            
            document.getElementById('webcamContainer').classList.remove('hidden');
            document.getElementById('loginScreen').classList.add('hidden');
            
            setStep(2);
            document.getElementById('instructionScreen').classList.remove('hidden');
          } else {
            stream.getTracks().forEach(track => track.stop());
            errBox.innerText = res.message || "Username atau Password salah!";
            errBox.classList.remove('hidden');
            btn.disabled = false;
            btn.innerHTML = "<span>Verifikasi & Lanjut ke Petunjuk</span> <span>→</span>";
          }
        })
        .catch(err => {
          stream.getTracks().forEach(track => track.stop());
          errBox.innerText = "Gagal terhubung ke server: " + err;
          errBox.classList.remove('hidden');
          btn.disabled = false;
          btn.innerHTML = "<span>Verifikasi & Lanjut ke Petunjuk</span> <span>→</span>";
        });
      })
      .catch(function(err) {
        btn.disabled = false;
        btn.innerHTML = "<span>Verifikasi & Lanjut ke Petunjuk</span> <span>→</span>";
        errBox.innerHTML = "<b>❌ Akses Kamera Ditolak!</b> Diwajibkan mengizinkan kamera untuk melanjutkan ujian.";
        errBox.classList.remove('hidden');
      });
    }

    function startActualExam() {
      document.getElementById('instructionScreen').classList.add('hidden');
      document.getElementById('examScreen').classList.remove('hidden');

      setStep(3);
      isExamActive = true;
      setupAntiCheating();
      renderQuestionGrid();
      renderCurrentQuestion();
      startTimer();

      photoInterval = setInterval(function() {
        takeSnapshot("INTERVAL");
      }, 120000);
    }

    function setupAntiCheating() {
      document.addEventListener("visibilitychange", function() {
        if (document.hidden && isExamActive) {
          registerViolation("Membuka Tab Lain / Minimalkan Browser");
        }
      });

      window.addEventListener("blur", function() {
        if (isExamActive) {
          registerViolation("Meninggalkan Jendela Ujian");
        }
      });
    }

    function registerViolation(reason) {
      if (!isExamActive) return;
      violationCount++;
      
      document.getElementById('dispViolations').innerText = `${violationCount} / 3`;
      document.getElementById('cheatCountDisp').innerText = violationCount;

      const banner = document.getElementById('cheatWarningBanner');
      banner.classList.remove('hidden');
      setTimeout(() => banner.classList.add('hidden'), 5000);

      if (violationCount >= 3) {
        isExamActive = false;
        alert("⚠️ PELANGGARAN MAKSIMAL (3x)! Anda dideteksi melakukan kecurangan. Ujian dihentikan dan Anda di-Take Out.");
        submitExam(true);
      } else {
        alert(`⚠️ PERINGATAN PELANGGARAN (${violationCount}/3)!\nAlasan: ${reason}.\nJika mencapai 3x pelanggaran Anda akan otomatis di-Take Out!`);
      }
    }

    function renderQuestionGrid() {
      const grid = document.getElementById('questionGrid');
      grid.innerHTML = "";
      
      questionsData.forEach((q, idx) => {
        const ansArr = userAnswers[q.no] || [];
        const isFilled = ansArr.length === 2;
        const isCurrent = idx === currentIndex;

        let btnClass = "py-2 text-xs font-bold rounded-lg border transition text-center ";
        if (isCurrent) {
          btnClass += "bg-blue-600 text-white border-blue-400 ring-2 ring-blue-400/50";
        } else if (isFilled) {
          btnClass += "bg-emerald-500/20 text-emerald-300 border-emerald-500/40 hover:bg-emerald-500/30";
        } else if (ansArr.length === 1) {
          btnClass += "bg-amber-500/20 text-amber-300 border-amber-500/40 hover:bg-amber-500/30";
        } else {
          btnClass += "bg-slate-900/60 text-slate-400 border-slate-700 hover:bg-slate-700/50";
        }

        const btn = document.createElement('button');
        btn.className = btnClass;
        btn.innerText = idx + 1;
        btn.onclick = () => jumpToQuestion(idx);
        grid.appendChild(btn);
      });
    }

    function jumpToQuestion(idx) {
      currentIndex = idx;
      renderCurrentQuestion();
    }

    function renderCurrentQuestion() {
      const q = questionsData[currentIndex];
      document.getElementById('questionIndicator').innerText = `Soal ${currentIndex + 1} dari 20 (No. ${q.no})`;
      
      const container = document.getElementById('optionsContainer');
      container.innerHTML = "";

      const currentSelected = userAnswers[q.no] || [];

      q.options.forEach(opt => {
        const isSelected = currentSelected.includes(opt.key);
        
        const card = document.createElement('div');
        card.className = `p-4 rounded-xl border cursor-pointer transition flex items-center justify-between ${
          isSelected 
            ? 'bg-blue-600/20 border-blue-500 text-white font-bold ring-1 ring-blue-500/50' 
            : 'bg-slate-900/80 border-slate-700/80 text-slate-300 hover:bg-slate-800'
        }`;

        card.onclick = () => toggleOption(q.no, opt.key);

        card.innerHTML = `
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-lg ${isSelected ? 'bg-blue-600 text-white' : 'bg-slate-800 text-slate-400 border border-slate-700'} flex items-center justify-center text-xs font-bold uppercase">
              ${opt.key}
            </span>
            <span class="text-sm">${opt.label}</span>
          </div>
          <div class="w-5 h-5 rounded-full border flex items-center justify-center ${isSelected ? 'border-blue-400 bg-blue-600 text-white text-xs' : 'border-slate-600'}">
            ${isSelected ? '✓' : ''}
          </div>
        `;

        container.appendChild(card);
      });

      document.getElementById('btnPrev').style.visibility = (currentIndex === 0) ? "hidden" : "visible";

      if (currentIndex === questionsData.length - 1) {
        document.getElementById('btnNext').classList.add('hidden');
        document.getElementById('btnSubmit').classList.remove('hidden');
      } else {
        document.getElementById('btnNext').classList.remove('hidden');
        document.getElementById('btnSubmit').classList.add('hidden');
      }

      renderQuestionGrid();
    }

    function toggleOption(qNo, key) {
      if (!userAnswers[qNo]) userAnswers[qNo] = [];
      let arr = userAnswers[qNo];

      if (arr.includes(key)) {
        userAnswers[qNo] = arr.filter(k => k !== key);
      } else {
        if (arr.length >= 2) {
          // Ganti pilihan tertua jika sudah memilih 2
          arr.shift();
        }
        arr.push(key);
      }
      renderCurrentQuestion();
    }

    function navigateQuestion(direction) {
      currentIndex += direction;
      if (currentIndex < 0) currentIndex = 0;
      if (currentIndex >= questionsData.length) currentIndex = questionsData.length - 1;
      renderCurrentQuestion();
    }

    function takeSnapshot(triggerType) {
      if (!videoStream) return null;
      try {
        canvas.width = 320;
        canvas.height = 240;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
        
        const base64Data = canvas.toDataURL('image/jpeg', 0.5);

        if (triggerType === "INTERVAL") {
          sendData({
            action: "saveSnapshot",
            username: currentUser ? currentUser.username : "",
            imageBase64: base64Data,
            triggerType: triggerType
          });
        }
        return base64Data;
      } catch (e) {
        return null;
      }
    }

    function startTimer() {
      updateTimerDisplay();
      timerInterval = setInterval(function() {
        timeLeft--;
        updateTimerDisplay();

        if (timeLeft <= 0) {
          clearInterval(timerInterval);
          alert("Waktu ujian (8 Menit) telah habis! Jawaban Anda akan otomatis dikirim.");
          submitExam(false);
        }
      }, 1000);
    }

    function updateTimerDisplay() {
      const m = Math.floor(timeLeft / 60);
      const s = timeLeft % 60;
      document.getElementById('timerDisplay').innerText = 
        `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
    }

    function submitExam(isForcedByCheat) {
      if (!isForcedByCheat) {
        if (!confirm("Apakah Anda yakin ingin mengirimkan seluruh jawaban Anda sekarang?")) return;
      }

      isExamActive = false;
      clearInterval(timerInterval);
      clearInterval(photoInterval);

      const btnSubmit = document.getElementById('btnSubmit');
      btnSubmit.disabled = true;
      btnSubmit.innerText = "Mengirim Jawaban...";

      const submitPhoto = takeSnapshot(isForcedByCheat ? "TAKEOUT" : "SUBMIT");

      // Format jawaban ke bentuk string "a, e" untuk tiap nomor
      let formattedAnswers = {};
      for (let no in userAnswers) {
        formattedAnswers[no] = userAnswers[no].join(", ");
      }

      sendData({
        action: "submitUjian",
        userData: currentUser,
        answers: formattedAnswers,
        imageBase64: submitPhoto,
        violations: violationCount,
        isTakeOut: isForcedByCheat
      })
      .then(res => {
        if (videoStream) {
          videoStream.getTracks().forEach(track => track.stop());
        }
        document.getElementById('webcamContainer').classList.add('hidden');

        if (res.success) {
          document.getElementById('examScreen').classList.add('hidden');
          setStep(4);

          if (isForcedByCheat) {
            document.getElementById('resultIcon').className = "w-16 h-16 bg-rose-500/10 border border-rose-500/30 text-rose-400 rounded-full flex items-center justify-center text-3xl mx-auto";
            document.getElementById('resultIcon').innerText = "🚫";
            document.getElementById('resultTitle').innerText = "UJIAN DIBATALKAN (TAKE OUT)";
            document.getElementById('resultDesc').innerText = "Anda telah dikeluarkan dari sesi ujian karena terdeteksi melakukan pelanggaran aturan/kecurangan sebanyak 3 kali.";
          }

          document.getElementById('resultScreen').classList.remove('hidden');
        } else {
          alert("Terjadi kesalahan: " + res.error);
          btnSubmit.disabled = false;
          btnSubmit.innerText = "Kirim Jawaban";
        }
      })
      .catch(err => {
        alert("Gagal terhubung ke server: " + err);
        btnSubmit.disabled = false;
        btnSubmit.innerText = "Kirim Jawaban";
      });
    }
  </script>
